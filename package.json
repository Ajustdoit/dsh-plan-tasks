{
  "name": "@chengfa/dsh-plan-tasks",
  "version": "1.1.1",
  "description": "DSH 侧边栏「任务列表」插件：读写项目根目录 .plan/plan.json，手风琴展示计划进度，并配合 .dsh/skills 技能按计划执行。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "plan",
    "task-list"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ajustdoit/dsh-plan-tasks.git"
  },
  "homepage": "https://github.com/Ajustdoit/dsh-plan-tasks#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.3 || >=0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/check-imports.mjs && node scripts/unused-imports.mjs && node scripts/unused-decls.mjs && node scripts/unused-decls.mjs --host && node scripts/dead-css.mjs && node build.mjs --check && node --check lib/client.js",
    "prepack": "node build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
