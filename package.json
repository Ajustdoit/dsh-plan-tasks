{
  "name": "dsh-plan-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 侧边栏「任务列表」插件：读写项目根目录 .plan/plan.json，手风琴展示计划进度，并配合 .dsh/skills 技能按计划执行。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.3"
  }
}
